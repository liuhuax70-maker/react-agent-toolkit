# ===== 复制本文件为 .env 并填写 =====
# .env 已被 .gitignore 忽略，不会提交到仓库

# ---------- LLM（DeepSeek，OpenAI 兼容） ----------
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

# ---------- Agent ----------
MAX_STEPS=6
TOOL_RETRIES=2
TOOL_TIMEOUT=10

# ---------- 工具工作目录 ----------
WORKSPACE_DIR=./data/workspace

# ---------- 日志 ----------
LOG_LEVEL=INFO
